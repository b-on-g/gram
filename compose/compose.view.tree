$bog_gram_compose $bog_gram_page
	title @ \New chat
	close? null
	open*? null
	users /string
	user_title* \
	user_source* \
	registry_ids /string
	join_needed false
	users_none @ \You are not in any registry. Create your own in settings
	users_alone @ \Nobody else is in the registries yet
	join? null
	tools /
		<= Close $mol_button_minor
			hint @ \Close
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Peer_form $mol_view
			sub /
				<= Peer_field $mol_string
					hint @ \Peer ID
					value? <=> peer? \
					submit? <=> start? null
				<= Peer_start $mol_button_major
					click? <=> start? null
					sub /
						<= start_label @ \Start chat
		<= Users_title $mol_paragraph
			title @ \Users
		<= Join_plate $mol_view
			sub /
				<= Join_plate_text $mol_paragraph
					title @ \You are not in this registry: others will not find you here
				<= Join_plate_button $mol_button_major
					click? <=> join?
					sub /
						<= join_label @ \Join
		<= Users_list $mol_list
			rows <= user_rows /
	Users_empty $mol_view
		sub /
			<= Users_empty_text $mol_paragraph
				title <= users_empty_text \
	User_row* $bog_gram_row
		click? <=> pick*? null
		avatar_id <= user_lord* \
		tint <= user_tint* 0
		title <= user_title*
		note <= user_source*
