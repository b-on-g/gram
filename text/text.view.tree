$bog_gram_text $mol_object
	talk_saved @ \Saved
	talk_photo @ \Photo
	talk_voice @ \Voice message
	talk_video @ \Video
	talk_call @ \Call
	talk_contact @ \Contact
	talk_mine @ \You: {text}
	clock_today @ \Today
	clock_yesterday @ \Yesterday
	count_people @ \{n} member|{n} members
	count_dialogs @ \{n} dialog|{n} dialogs
	lobby_key_bad @ \The key in the request does not match its owner: request rejected
	lobby_lost @ \The link has no group creator, there is no one to take the request to. Ask for a fresh link
	lobby_denied_one @ \Your request was declined. You can ask again with the same link
	lobby_denied_some @ \Requests declined: {n}. You can ask again with the same links
	lobby_queued_one @ \The request is being sent, it is not instant
	lobby_queued_some @ \Requests being sent: {n}
	lobby_sent_one @ \Request sent, waiting for it to be accepted
	lobby_sent_some @ \Requests sent: {n}, waiting for them to be accepted
	crew_self @ \This is your own ID
	crew_bad_id @ \This does not look like an ID
	crew_no_key_read @ \Could not find this person's key: without it they cannot read the conversation
	crew_no_keys @ \Could not find the keys of all members: a new part of the conversation cannot be started without them
	crew_no_key_grant @ \Could not find this person's key: cannot grant them rights
	alerts_off_label @ \Turn off
	alerts_on_label @ \Turn on notifications
	alerts_unsupported @ \Not supported by this browser
	alerts_denied @ \Blocked in the browser
	alerts_active @ \Notifications are on
	alerts_reset @ \The browser reset the permission, turn them on again
	alerts_off @ \Off
	alerts_later @ \We will ask for permission when you open a conversation
	invite_lost @ \The link to the conversation is broken, ask for a fresh one
	invite_wait @ \Opening the conversation, looking for the other person's key
	invite_late @ \The other person's key was not found: most likely they have not opened Gram yet or are connected to a different master. Ask for a fresh link
	roster_from_chats @ \from conversations
	registry_status @ \{people} · {mine}
	registry_joined @ \you are on the list
	registry_watching @ \view only
	account_lost @ \Could not load account data
	voice_unsupported @ \Audio recording is not supported here
	forward_lost @ \Not forwarded: key not delivered — {names}. Try again a bit later
	forward_unloaded @ \The attachment has not loaded yet: open it and try again
	contact_unknown @ \This person's key is not known yet, there is nothing to share
