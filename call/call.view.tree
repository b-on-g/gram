$bog_gram_call $mol_page
	land null
	name \
	close? null
	Room $bog_gram_call_room
		land <= land
		name <= name
	title @ \Call
	tools /
		<= Close $mol_button_minor
			hint @ \Exit and close
			click? <=> close_click? null
			sub /
				<= Close_icon $mol_icon_close
	body <= content /
	foot <= controls /
	Grid $mol_view
		sub <= tiles /
	Self $bog_gram_call_tile
		stream <= self_stream null
		muted true
		mirror <= self_mirror true
		awake <= awake true
		cam <= cam
		mic <= mic
		name <= self_name @ \You
	Mate* $bog_gram_call_tile
		stream <= mate_stream* null
		awake <= awake
		cam <= mate_cam* true
		mic <= mate_mic* true
		name <= mate_name* \
		status <= mate_status* \
		stats <= mate_stats* null
	Lobby $mol_list
		rows /
			<= Lobby_text $mol_paragraph
				title <= lobby_text \
			<= Join $mol_button_major
				title @ \Join the call
				click? <=> join? null
	Mic $mol_check_icon
		Icon <= Mic_icon $mol_icon_microphone
		hint @ \Microphone
		checked? <=> mic? true
	Cam $mol_check_icon
		Icon <= Cam_icon $mol_icon_video
		hint @ \Camera
		checked? <=> cam? true
		enabled <= cam_able true
	Flip $mol_button_minor
		hint @ \Flip camera
		click? <=> cam_switch? null
		sub /
			<= Flip_icon $mol_icon_camera_flip
	Stats_show $mol_check_icon
		Icon <= Stats_icon $mol_icon_signal
		hint @ \Show FPS and network
		checked? <=> stats_show? true
	Pip $mol_button_minor
		hint @ \Picture in picture
		click? <=> pip? null
		sub /
			<= Pip_icon $mol_icon_picture_in_picture_bottom_right
	Leave $mol_button_minor
		hint @ \Leave the call
		click? <=> leave? null
		sub /
			<= Leave_icon $mol_icon_phone_hangup
	lobby_empty @ \Nobody in the call yet
	lobby_some @ \In the call: {names}
