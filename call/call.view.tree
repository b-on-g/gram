$bog_gram_call $mol_page
	land null
	name \
	knocks /string
	knock_name* \
	admit*? null
	deny*? null
	knocks_pattern @ \Knocking: {count}
	note* \
	close? null
	Room $bog_gram_call_room
		land <= land
		name <= name
	title @ \Call
	tools /
		<= Invite $mol_button_copy
			hint @ \Copy the meeting link
			text <= invite_link \
		<= Invite_qr_pick $mol_pick
			hint @ \Show the meeting QR
			trigger_content /
				<= Invite_qr_icon $mol_icon_qrcode
			bubble_content /
				<= Invite_qr_box $mol_view
					sub /
						<= Invite_qr $bog_qr
							uri <= invite_link
							gradient_stops /
								\#2f6f9e
								\#4fb3d1
		<= Close $mol_button_minor
			hint @ \Exit and close
			click? <=> close_click? null
			sub /
				<= Close_icon $mol_icon_close
	body <= content /
	foot <= controls /
	Knocks $mol_list
		rows <= knock_rows /
	Knocks_head $mol_paragraph
		title <= knocks_head \
	Knock* $mol_view
		sub /
			<= Knock_name* $mol_paragraph
				title <= knock_name*
			<= Knock_admit* $mol_button_minor
				hint @ \Let in
				click? <=> admit*?
				sub /
					<= Knock_admit_icon* $mol_icon_check
			<= Knock_deny* $mol_button_minor
				hint @ \Decline
				click? <=> deny*?
				sub /
					<= Knock_deny_icon* $mol_icon_close
	Grid $mol_view
		sub <= tiles /
	Self $bog_gram_call_tile
		stream <= self_stream null
		muted true
		mirror <= self_mirror true
		screen <= self_screen false
		status <= self_status \
		awake <= awake true
		cam <= self_cam true
		mic <= mic
		speaker <= speaker_source
		name <= self_name @ \You
	Mate* $bog_gram_call_tile
		stream <= mate_stream* null
		awake <= awake
		cam <= mate_cam* true
		screen <= mate_screen* false
		mic <= mate_mic* true
		speaker <= speaker_source
		name <= mate_name* \
		status <= mate_status* \
		stats <= mate_stats* null
	Lobby $mol_list
		rows /
			<= Lobby_text $mol_paragraph
				title <= lobby_text \
			<= Join $mol_button_major
				title @ \Join the call
				click? <=> join? null
	Mic $mol_check_icon
		Icon <= Mic_icon $mol_icon_microphone
		hint @ \Microphone
		checked? <=> mic? true
	Mic_source $mol_select
		hint @ \Microphone source
		dictionary <= mic_dictionary *
		value? <=> mic_source? \
	Speaker $mol_select
		hint @ \Sound output
		dictionary <= speaker_dictionary *
		value? <=> speaker_source? \
	source_default @ \System default
	Cam $mol_check_icon
		Icon <= Cam_icon $mol_icon_video
		hint @ \Camera
		checked? <=> cam? true
		enabled <= cam_able true
	Screen $mol_check_icon
		Icon <= Screen_icon $mol_icon_monitor
		hint @ \Share screen
		checked? <=> screen? false
	Flip $mol_button_minor
		hint @ \Flip camera
		click? <=> cam_switch? null
		sub /
			<= Flip_icon $mol_icon_camera_flip
	Stats_show $mol_check_icon
		Icon <= Stats_icon $mol_icon_signal
		hint @ \Show FPS and network
		checked? <=> stats_show? true
	Pip $mol_button_minor
		hint @ \Picture in picture
		click? <=> pip? null
		sub /
			<= Pip_icon $mol_icon_picture_in_picture_bottom_right
	Leave $mol_button_minor
		hint @ \Leave the call
		click? <=> leave? null
		sub /
			<= Leave_icon $mol_icon_phone_hangup
	lobby_empty @ \Nobody in the call yet
	lobby_some @ \In the call: {names}
