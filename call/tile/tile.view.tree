$bog_gram_call_tile $mol_view
	stream null
	muted false
	mirror false
	cam true
	mic true
	awake true
	name \
	status \
	stats \
	failed_text @ \Нет связи
	connecting_text @ \Соединяюсь…
	attr *
		^
		bog_gram_call_tile_cam <= cam
		bog_gram_call_tile_mirror <= mirror
	sub /
		<= Video $mol_video_player
			stream <= stream
			controls false
			muted <= muted
			attr *
				^
				autopictureinpicture true
		<= Face $mol_view
			sub /
				<= letter \
		<= Stats $mol_view
			sub /
				<= stats
		<= Label $mol_view
			sub <= label /
				<= Name $mol_view
					sub /
						<= name
				<= Mic_off $mol_icon_microphone_off
				<= Status $mol_view
					sub /
						<= status_text \
