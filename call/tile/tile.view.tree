$bog_gram_call_tile $mol_view
	stream null
	muted false
	mirror false
	cam true
	mic true
	awake true
	name \
	status \
	stats null
	stat_fps @ \{n} fps
	stat_size @ \{n}
	stat_kbps @ \{n} kbps
	stat_loss @ \loss {n}%
	stat_rtt @ \{n} ms
	Stat* $mol_view
		attr *
			bog_gram_call_tile_stat_bad <= stat_bad* false
		sub /
			<= stat_text* \
	failed_text @ \No connection
	connecting_text @ \Connecting…
	attr *
		^
		bog_gram_call_tile_cam <= cam
		bog_gram_call_tile_mirror <= mirror
	sub /
		<= Video $mol_video_player
			stream <= stream
			controls false
			muted <= muted
			attr *
				^
				autopictureinpicture true
		<= Face $mol_view
			sub /
				<= letter \
		<= Stats $mol_view
			sub <= stat_parts /
		<= Label $mol_view
			sub <= label /
				<= Name $mol_view
					sub /
						<= name
				<= Mic_off $mol_icon_microphone_off
				<= Status $mol_view
					sub /
						<= status_text \
