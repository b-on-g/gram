$bog_gram_call_card $mol_button_minor
	land null
	Room $bog_gram_call_room
		land <= land
	sub /
		<= Icon $mol_icon_phone
		<= Info $mol_view
			sub /
				<= Title $mol_view
					sub /
						<= title @ \Call
				<= Count $mol_view
					sub /
						<= count_text \
	count_none @ \Nobody here now, tap to join
	count_some @ \In the call: {count}
