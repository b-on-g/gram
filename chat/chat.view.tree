$bog_gram_chat $bog_gram_page
	dialog \
	my_lord \
	Talk $bog_gram_talk
	People $bog_gram_people
	Alerts $bog_gram_alerts
	close? null
	members? null
	call_open? null
	forward_open? null
	contact_share? null
	contact_open? null
	note? \
	note_hint \
	note_editable false
	members_shown false
	edit_mode false
	reply_mode false
	reply_title \
	reply_text \
	message_text? \
	voice_ready false
	voice_on false
	voice_clock \
	voice_hint? \
	voice_denied @ \Microphone unavailable: allow recording in the browser settings
	voice_short @ \Too short, recording cancelled
	call_lost_pattern @ \Call not started: key not delivered — {names}. Call again a bit later
	read_pattern @ \Read by {count} of {total}
	self_name @ \You
	kind_photo @ \Photo
	kind_voice @ \Voice message
	kind_video @ \Video
	kind_contact @ \Contact
	kind_round @ \Video message
	record_mode? \voice
	record_stream? null
	reply_pattern @ \Reply to {name}
	video_failed @ \Video was not sent
	images_capped_pattern @ \Only the first {limit} photos were sent: at most {limit} at a time
	lost_pattern @ \{what} not sent: key not delivered — {names}. Send again a bit later
	video_big_pattern @ \Video over {limit} MB cannot be compressed, this one is {size} MB
	video_packing @ \Compressing video…
	video_progress_pattern @ \Compressing video: {percent}%
	video_over_pattern @ \Video does not fit: {size} MB after compression, the limit is {limit} MB
	edit_id? \
	reply_id? \
	message_menu? \
	zoom_id? \
	voice_start? 0
	voice_playing? \
	stick_end? false
	rows_seen? 0
	event *
		^
		paste? <=> image_paste? null
		dragover? <=> image_over? null
		drop? <=> image_drop? null
	plugins /
		<= Hotkey $mol_hotkey
			key * escape? <=> zoom_close? null
	Gallery $bog_gram_gallery
		ids <= shots /string
		current? <=> zoom_id?
		uri* <= shot_uri*
		close? <=> zoom_close?
	title_content /
		<= Note_field $bog_gram_field
			hint <= note_hint
			value? <=> note?
		<= Title_text $mol_view
			sub /
				<= title
	head /
		<= Back $mol_button_minor
			hint @ \Back
			click? <=> close?
			sub /
				<= Back_icon $mol_icon_arrow_left
		<= Title
		<= Tools
	tools /
		<= Share $mol_button_minor
			hint @ \Share this contact
			click? <=> share? null
			sub /
				<= Share_icon $mol_icon_account_arrow_right
		<= Call $mol_button_minor
			hint @ \Call
			click? <=> call_start? null
			sub /
				<= Call_icon $mol_icon_phone
		<= Members $mol_button_minor
			hint @ \Members
			click? <=> members?
			sub /
				<= Members_icon $mol_icon_account_multiple
		<= Close $mol_button_minor
			hint @ \Close
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Messages $mol_list
			rows <= rows /$mol_view
	foot /
		<= Reply_banner $mol_view
			sub /
				<= Reply_icon $mol_icon_reply
				<= Reply_info $mol_view
					sub /
						<= Reply_title $mol_view
							sub /
								<= reply_title
						<= Reply_text $mol_view
							sub /
								<= reply_text
				<= Reply_cancel $mol_button_minor
					hint @ \Cancel reply
					click? <=> reply_cancel? null
					sub /
						<= Reply_cancel_icon $mol_icon_close
		<= Edit_banner $mol_view
			sub /
				<= Edit_banner_text $mol_paragraph
					title @ \Editing
				<= Edit_cancel $mol_button_minor
					hint @ \Cancel edit
					click? <=> edit_cancel? null
					sub /
						<= Edit_cancel_icon $mol_icon_close
		<= Voice_note $mol_paragraph
			title <= voice_hint
		<= Round_live $mol_video_player
			stream <= record_stream?
			controls false
			muted true
		<= Send_row $mol_view
			sub <= send_tools /
	Attach $bog_gram_attach
		hint @ \Send photo or video
		accept \image/*,video/*
		multiple true
		files? <=> image_files? null
		Icon <= Attach_icon $mol_icon_paperclip
	Message_box $mol_view
		sub /
			<= Message_field $bog_gram_write
				hint @ \Message…
				value? <=> message_text?
				send? <=> message_send? null
	Send $mol_button_major
		hint @ \Send
		click? <=> message_send?
		sub /
			<= Send_icon $mol_icon_send
	Voice $bog_gram_hold
		hint <= voice_hint_text \
		press? <=> voice_press? null
		move? <=> voice_move? null
		release? <=> voice_release? null
		abort? <=> voice_abort? null
		sub /
			<= record_icon $mol_icon_microphone
	voice_mode_hint @ \Hold to record a voice message, tap for a video message
	round_mode_hint @ \Hold to record a video message, tap for a voice message
	Voice_icon $mol_icon_microphone
	Round_icon $mol_icon_video
	Record_state $mol_view
		sub /
			<= Record_dot $mol_view
			<= Record_time $mol_view
				sub /
					<= voice_clock
	Record_slide $mol_view
		sub /
			<= record_slide_text @ \← slide to cancel · ↑ to lock
	Record_drop $mol_button_minor
		hint @ \Delete recording
		click? <=> voice_cancel? null
		sub /
			<= Record_drop_icon $mol_icon_delete
	Record_stop $mol_button_minor
		hint @ \Stop and listen
		click? <=> record_stop? null
		sub /
			<= Record_stop_icon $mol_icon_stop
	Record_send $mol_button_major
		hint @ \Send recording
		click? <=> record_send? null
		sub /
			<= Record_send_icon $mol_icon_send
	Draft $mol_view
		sub <= draft_sub /
	Draft_sound $bog_gram_sound
		uri <= draft_uri \
		span <= draft_span 0
		playing <= draft_playing? false
		toggle? <=> draft_toggle? null
		ended? <=> draft_ended? null
	Draft_round $bog_gram_round
		uri <= draft_uri
		span <= draft_span
		playing <= draft_playing?
		toggle? <=> draft_toggle?
		ended? <=> draft_ended?
	Line* $mol_view
		minimal_height 48
		sub <= line_content* /
	Day_row* $mol_view
		sub /
			<= Day_chip* $mol_view
				sub /
					<= day_title* \
	Bubble* $bog_gram_bubble
		out <= message_out* false
		menu <= message_menu_is* false
		author <= message_author* \
		author_tint <= message_author_tint* 0
		quote_shown <= message_quote_shown* false
		quote_author <= message_quote_author* \
		quote_text <= message_quote_text* \
		quote_jump? <=> message_quote_jump*? null
		shot <= message_shot* false
		shots <= message_shots* /string
		shot_uri* <= shot_uri* \
		shot_ratio* <= shot_ratio* 1
		shot_width <= message_shot_width* \
		shot_open*? <=> shot_zoom*? null
		sound <= message_sound* false
		sound_uri <= message_sound_uri* \
		sound_span <= message_sound_span* 0
		sound_playing <= message_sound_playing* false
		sound_toggle? <=> message_sound_toggle*? null
		sound_ended? <=> message_sound_ended*? null
		round <= message_round* false
		round_uri <= message_round_uri* \
		round_span <= message_round_span* 0
		round_toggle? <=> message_sound_toggle*?
		round_ended? <=> message_sound_ended*?
		video <= message_video* false
		video_uri <= message_video_uri* \
		video_ratio <= message_video_ratio* 1.78
		call <= message_call* false
		call_land <= message_call_land* null
		call_open? <=> message_call_open*? null
		forwarded <= message_forwarded* false
		contact <= message_contact* false
		contact_name <= message_contact_name* \
		contact_open? <=> message_contact_open*? null
		forwardable <= message_forwardable* true
		forward? <=> message_forward*? null
		body <= message_body* \
		time <= message_time* \
		edited <= message_edited* false
		checks <= message_checks* \
		edit? <=> message_edit*? null
		delete? <=> message_delete*? null
		press? <=> message_press*? null
		release? <=> message_release*? null
		context? <=> message_context*? null
