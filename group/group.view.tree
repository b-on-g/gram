$bog_gram_group $bog_gram_page
	title @ \New group
	close? null
	name? \
	picked /string
	lost /string
	id? \
	id_error \
	pick*? null
	drop*? null
	id_add? null
	make? null
	label* \
	contact_lords /string
	contact_source* \
	chosen_none @ \Nobody picked yet
	lost_pattern @ \Keys not found: {names}. Without a key a person cannot read the chat, but the group can be created without them.
	make_without @ \Create without them
	make_group @ \Create group
	tools /
		<= Close $mol_button_minor
			hint @ \Close
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Name_field $mol_string
			hint @ \Group name
			value? <=> name?
		<= Chosen_head $mol_paragraph
			title <= chosen_head \
		<= Chosen_list $mol_list
			rows <= chosen_rows /
		<= Lost_note $mol_paragraph
			title <= lost_note \
		<= Make $mol_button_major
			click? <=> make?
			sub /
				<= make_label \
		<= Id_form $mol_view
			sub /
				<= Id_field $mol_string
					hint @ \Member ID
					value? <=> id?
					submit? <=> id_add?
				<= Id_add $mol_button_major
					click? <=> id_add?
					sub /
						<= id_add_label @ \Add
		<= Id_error $mol_paragraph
			title <= id_error
		<= Pick_head $mol_paragraph
			title @ \Whom to invite
		<= Pick_list $mol_list
			rows <= pick_rows /
	Pick_row* $bog_gram_row
		click? <=> pick*?
		current <= picked_is* false
		avatar_id <= person* \
		tint <= tint* 0
		title <= label*
		note <= contact_source*
		marks /
			<= Pick_mark* $mol_icon_check
	Chosen_row* $bog_gram_row
		enabled false
		size \tiny
		avatar_id <= person* \
		tint <= tint* 0
		title <= label*
		tools /
			<= Chosen_drop* $mol_button_minor
				hint @ \Remove from the list
				click? <=> drop*?
				sub /
					<= Chosen_drop_icon* $mol_icon_close
