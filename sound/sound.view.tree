$bog_gram_sound $mol_view
	uri \
	span 0
	playing false
	toggle? null
	ended? null
	sub /
		<= Toggle $mol_button_minor
			hint \Прослушать
			click? <=> toggle?
			sub <= toggle_icons /
		<= Track $mol_view
			sub /
				<= Fill $mol_view
					style *
						width <= fill_width \0%
		<= Stamp $mol_view
			sub /
				<= stamp \
		<= Node $bog_gram_sound_node
			uri <= uri
			ended? <=> ended?
	Play_icon $mol_icon_play
	Pause_icon $mol_icon_pause
