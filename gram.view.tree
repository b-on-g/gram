$bog_gram $mol_book2
	plugins /
		<= Skin $bog_builderui_skin
			lights <= lights \system
			base \zinc
			font_head \eb-garamond
		<= Theme $bog_theme_auto
	Account $bog_gram_account
		my_lord => my_lord
		my_pass => my_pass
		user_name? => user_name?
		dialogs_store => dialogs_store
		monitor_store => monitor_store
		monitor_link => monitor_link
		ready => account_ready
	Registry $bog_gram_registry
		Account <= Account
		ids => registry_ids
		active => registry_active
		title* => registry_title*
		status* => registry_status*
		joined* => registry_joined*
		active_is* => registry_active_is*
		uri => registry_uri
		name? => registry_name?
		make? => registry_make?
		open*? => registry_open*?
		join*? => registry_join*?
		join_active? => registry_join_active?
		forget*? => registry_forget*?
		join_needed => registry_join_needed
		sources => user_sources
		people => user_lords
		source_title* => user_source*
		remember => registry_remember
		keys_fill => registry_keys_fill
	People $bog_gram_people
		Account <= Account
		Registry <= Registry
		name* => peer_name*
		note* => peer_note*
		label* => peer_label*
		known* => peer_known*
		accept* => peer_accept*
		pass_of* => peer_pass_of*
	Talk $bog_gram_talk
		Account <= Account
		People <= People
		saved_title => saved_title
		saved_id => saved_id
		saved_links => saved_links
		saved_is* => saved_is*
		saved_land => saved_land
		store* => dialog_store*
		lords* => dialog_lords*
		mates* => dialog_mates*
		peer* => dialog_peer*
		group_title* => group_title*
		group_is* => group_is*
		group_name_auto* => group_name_auto*
		admins* => admin_lords*
		admin_me* => admin_me*
		owner* => dialog_owner*
		own* => dialog_own*
		title* => dialog_title*
		avatar_id* => dialog_avatar_id*
		tint* => dialog_tint*
		moment* => dialog_moment*
		alive* => dialog_alive*
		links_of* => session_links_of*
		land* => session_land_by*
		lands_of* => session_lands_of*
		land_of* => session_land_of*
		session* => session_store_last*
		messages_of* => messages_of*
		messages_alive_of* => messages_alive_of*
		unread* => unread_total*
		preview* => dialog_preview*
		time* => dialog_time*
		mine_wrote* => mine_wrote*
	Roster $bog_gram_roster
		Account <= Account
		People <= People
		Talk <= Talk
		ids => dialog_ids
		hidden => hidden_ids
		kind* => dialog_kind*
		requests => request_ids
		archived => archive_ids
		archive_is* => archive_is*
		visible => dialog_visible
		with* => dialog_with*
		invites_merge => inbox_merge
		watch_fill => monitor_fill
		contact_lords => contact_lords
		contact_source* => contact_source*
	Crew $bog_gram_crew
		Account <= Account
		People <= People
		Talk <= Talk
		error? => member_error?
		history? => member_history?
		draft_name? => group_name?
		draft_picked => group_picked
		draft_lost => group_lost
		draft_id? => group_id?
		draft_error => group_id_error
		draft_pick*? => group_pick*?
		draft_drop*? => group_chosen_drop*?
		draft_id_add? => group_id_add?
	Lobby $bog_gram_lobby
		Account <= Account
		People <= People
		Talk <= Talk
		Roster <= Roster
		Crew <= Crew
		outbox_flush => outbox_flush
		denies_merge => denies_merge
		asks_flush => asks_flush
		plate => ask_plate_text
		lord_of* => ask_lord*
	Invite $bog_gram_invite
		Account <= Account
		People <= People
		Roster <= Roster
		link => invite_link
		plate => invite_plate_text
		pending? => dialog_pending?
		drop? => invite_drop?
		timer => pending_timer
	Alerts $bog_gram_alerts
		Account <= Account
		supported => notify_supported
		status => notify_status
		label => notify_label
		toggle? => notify_toggle?
		on? => notify_on?
		auto => notify_auto
	Placeholder <= Intro $mol_view
		sub /
			<= Intro_plate $mol_view
				sub /
					<= Intro_title $mol_paragraph
						title \Выберите диалог
					<= Intro_hint $mol_paragraph
						title \Или начните новый: кнопка в шапке списка
	pages /
		<= Menu $bog_gram_menu
			Theme <= Theme
			compose? <=> compose_open? null
			group? <=> group_open? null
			music? <=> music_open? null
			settings? <=> settings_open? null
			invite_plate_text <= invite_plate_text
			invite_drop? <=> invite_drop?
			ask_plate_text <= ask_plate_text
			visible <= dialog_visible
			archived <= archive_fresh /string
			requests <= request_ids
			dialog_title* <= dialog_title*
			dialog_time* <= dialog_time*
			dialog_preview* <= dialog_preview*
			dialog_avatar_id* <= dialog_avatar_id*
			dialog_tint* <= dialog_tint*
			unread* <= unread_count* 0
			current_is* <= dialog_current_is* false
			request_is* <= request_is* false
			archive_is* <= archive_is*
			select*? <=> dialog_select*? null
			archive*? <=> dialog_archive*? null
			unarchive*? <=> dialog_unarchive*? null
			drop*? <=> dialog_delete*? null
			accept*? <=> request_accept*? null
			saved_title <= saved_title
			saved_time <= saved_time \
			saved_preview <= saved_preview \
			saved_current <= saved_current_is false
			saved_open? <=> saved_open? null
		<= Music_page $bog_gram_music
			hidden <= music_hidden false
			close? <=> music_close? null
		<= Settings_page $bog_gram_settings
			close? <=> settings_close? null
			user_name? <=> user_name?
			my_lord <= my_lord
			invite_link <= invite_link
			notify_status <= notify_status
			notify_label <= notify_label
			notify_supported <= notify_supported
			notify_toggle? <=> notify_toggle?
			notify_on? <=> notify_on?
			registry_ids <= registry_ids
			registry_active <= registry_active
			registry_uri <= registry_uri
			registry_name? <=> registry_name?
			registry_make? <=> registry_make?
			registry_title* <= registry_title*
			registry_status* <= registry_status*
			registry_joined* <= registry_joined*
			registry_active_is* <= registry_active_is*
			registry_open*? <=> registry_open*?
			registry_join*? <=> registry_join*?
			registry_forget*? <=> registry_forget*?
		<= Compose_page $bog_gram_compose
			close? <=> compose_close? null
			open*? <=> dialog_open*? null
			users <= user_lords
			user_title* <= peer_label*
			user_source* <= user_source*
			registry_ids <= registry_ids
			join_needed <= registry_join_needed
			join? <=> registry_join_active?
		<= Group_page $bog_gram_group
			close? <=> group_close? null
			make? <=> group_make? null
			name? <=> group_name?
			picked <= group_picked
			lost <= group_lost
			id? <=> group_id?
			id_error <= group_id_error
			pick*? <=> group_pick*?
			drop*? <=> group_chosen_drop*?
			id_add? <=> group_id_add?
			label* <= peer_label*
			contact_lords <= contact_lords
			contact_source* <= contact_source*
		<= Members_page $bog_gram_members
			close? <=> members_close? null
			me <= my_lord
			lords <= member_lords /string
			label* <= peer_label*
			status* <= member_status* \
			admin <= members_admin false
			owner <= members_owner false
			admin_is* <= member_admin* false
			error? <=> member_error?
			join_link <= join_link \
			asks <= members_asks /string
			ask_lord* <= ask_lord*
			accept*? <=> ask_accept*? null
			reject*? <=> ask_reject*? null
			candidates <= member_candidates /string
			contact_source* <= contact_source*
			history? <=> member_history?
			add*? <=> member_add*? null
			part*? <=> member_drop*? null
			promote*? <=> member_raise*? null
			leave? <=> group_leave? null
		<= Chat_page $bog_gram_chat
			title <= chat_title \
			focus_key <= chat_dialog \
			focus_row <= chat_focus_row null
			members_shown <= chat_members_shown false
			members? <=> members_open? null
			note? <=> chat_note? \
			note_hint <= chat_note_hint \
			note_editable <= chat_note_editable false
			rows <= chat_rows /
			edit_mode <= edit_mode false
			message_text? <=> message_text? \
			message_send? <=> message_send? null
			edit_cancel? <=> edit_cancel? null
			reply_mode <= reply_mode false
			reply_title <= reply_title \
			reply_text <= reply_text \
			reply_cancel? <=> reply_cancel? null
			close? <=> dialog_close? null
			image_files? <=> image_files? null
			image_paste? <=> image_paste? null
			image_over? <=> image_over? null
			image_drop? <=> image_drop? null
			zoom_uri <= zoom_uri \
			zoom_close? <=> zoom_close? null
			voice_on <= voice_on false
			voice_ready <= voice_ready false
			voice_clock <= voice_clock \
			voice_hint <= voice_hint \
			voice_press? <=> voice_press? null
			voice_release? <=> voice_release? null
			voice_abort? <=> voice_abort? null
			voice_cancel? <=> voice_cancel? null
			voice_menu? <=> voice_menu? null
	Day_row* $mol_view
		sub /
			<= Day_chip* $mol_view
				sub /
					<= day_title* \
	Message_row* $mol_view
		attr *
			^
			bog_gram_out <= message_out* false
			bog_gram_menu <= message_menu_is* false
		event *
			^
			pointerdown? <=> message_press*? null
			pointerup? <=> message_release*? null
			pointercancel? <=> message_release*? null
			contextmenu? <=> message_context*? null
		sub /
			<= Message_author* $mol_view
				attr *
					^
					bog_gram_tint <= message_author_tint* 0
				sub /
					<= message_author* \
			<= Message_quote* $mol_button_minor
				hint \Перейти к сообщению
				click? <=> message_quote_jump*? null
				sub /
					<= Message_quote_author* $mol_view
						sub /
							<= message_quote_author* \
					<= Message_quote_text* $mol_view
						sub /
							<= message_quote_text* \
			<= Message_shot* $bog_gram_photo
				hint \Открыть картинку
				uri <= message_shot_uri* \
				box_width <= message_shot_width* \
				box_ratio <= message_shot_ratio* \
				click? <=> message_zoom*? null
			<= Message_sound* $bog_gram_sound
				uri <= message_sound_uri* \
				span <= message_sound_span* 0
				playing <= message_sound_playing* false
				toggle? <=> message_sound_toggle*? null
				ended? <=> message_sound_ended*? null
			<= Message_body* $mol_paragraph
				title <= message_body* \
			<= Message_meta* $mol_view
				sub /
					<= Message_time* $mol_view
						sub /
							<= message_time* \
					<= Message_edited* $mol_view
						sub /
							\изменено
					<= Message_checks* $mol_view
						sub /
							<= message_checks* \
			<= Message_actions* $mol_view
				sub /
					<= Message_edit* $mol_button_minor
						hint \Редактировать
						click? <=> message_edit*? null
						sub /
							<= Message_edit_icon* $mol_icon_pencil
					<= Message_delete* $mol_button_minor
						hint \Удалить
						click? <=> message_delete*? null
						sub /
							<= Message_delete_icon* $mol_icon_delete

$bog_gram_field $mol_view
	hint \
	value? \
	sub /
		<= Field $mol_string_button
			hint <= hint
			value? <=> value? \
		<= Edit_icon $mol_icon_pencil

$bog_gram_chat $mol_page
	rows /$mol_view
	focus_key \
	focus_row null
	edit_mode false
	reply_mode false
	reply_title \
	reply_text \
	reply_cancel? null
	message_text? \
	message_send? null
	edit_cancel? null
	close? null
	note_editable false
	members_shown false
	members? null
	image_files? null
	image_paste? null
	image_over? null
	image_drop? null
	zoom_uri \
	zoom_close? null
	voice_on false
	voice_ready false
	voice_clock \
	voice_hint \
	voice_press? null
	voice_release? null
	voice_abort? null
	voice_cancel? null
	voice_menu? null
	event *
		^
		paste? <=> image_paste? null
		dragover? <=> image_over? null
		drop? <=> image_drop? null
	Zoom $bog_gram_zoom
		uri <= zoom_uri
		close? <=> zoom_close? null
	title_content /
		<= Note_field $bog_gram_field
			hint <= note_hint \
			value? <=> note? \
		<= Title_text $mol_view
			sub /
				<= title
	head /
		<= Back $mol_button_minor
			hint \Назад
			click? <=> close? null
			sub /
				<= Back_icon $mol_icon_arrow_left
		<= Title
		<= Tools
	tools /
		<= Members $mol_button_minor
			hint \Участники
			click? <=> members? null
			sub /
				<= Members_icon $mol_icon_account_multiple
		<= Close $mol_button_minor
			hint \Закрыть
			click? <=> close? null
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Messages $mol_list
			rows <= rows
	foot /
		<= Foot $mol_view
			sub /
				<= Reply_banner $mol_view
					sub /
						<= Reply_icon $mol_icon_reply
						<= Reply_info $mol_view
							sub /
								<= Reply_title $mol_view
									sub /
										<= reply_title
								<= Reply_text $mol_view
									sub /
										<= reply_text
						<= Reply_cancel $mol_button_minor
							hint \Отменить ответ
							click? <=> reply_cancel? null
							sub /
								<= Reply_cancel_icon $mol_icon_close
				<= Edit_banner $mol_view
					sub /
						<= Edit_banner_text $mol_paragraph
							title \Редактирование
						<= Edit_cancel $mol_button_minor
							hint \Отменить правку
							click? <=> edit_cancel? null
							sub /
								<= Edit_cancel_icon $mol_icon_close
				<= Voice_note $mol_paragraph
					title <= voice_hint
				<= Send_row $mol_view
					sub <= send_tools /
	Attach $mol_button_open
		hint \Отправить картинку
		accept \image/*
		multiple false
		files? <=> image_files? null
		Icon <= Attach_icon $mol_icon_paperclip
	Message_field $mol_string
		hint \Сообщение…
		value? <=> message_text? \
		submit? <=> message_send? null
	Send $mol_button_major
		hint \Отправить
		click? <=> message_send? null
		sub /
			<= Send_icon $mol_icon_send
	Voice $mol_button_minor
		hint \Удерживайте для записи
		event *
			^
			pointerdown? <=> voice_press? null
			pointerup? <=> voice_release? null
			pointercancel? <=> voice_abort? null
			contextmenu? <=> voice_menu? null
		sub /
			<= Voice_icon $mol_icon_microphone
	Record_state $mol_view
		sub /
			<= Record_dot $mol_view
			<= Record_time $mol_view
				sub /
					<= voice_clock
	Voice_cancel $mol_button_minor
		hint \Отпустите здесь, чтобы отменить
		click? <=> voice_cancel? null
		sub /
			<= Voice_cancel_icon $mol_icon_close
			<= Voice_cancel_text $mol_view
				sub /
					\Отмена

$bog_gram_avatar $mol_avatar
	id \
	tint 0
	attr *
		^
		bog_gram_tint <= tint

$bog_gram_photo $mol_button
	uri \
	box_width \15rem
	box_ratio \1
	style *
		width <= box_width
		aspectRatio <= box_ratio
	sub /
		<= Image $mol_image
			uri <= uri

$bog_gram_sound $mol_view
	uri \
	span 0
	playing false
	toggle? null
	ended? null
	sub /
		<= Toggle $mol_button_minor
			hint \Прослушать
			click? <=> toggle? null
			sub <= toggle_icons /
		<= Track $mol_view
			sub /
				<= Fill $mol_view
					style *
						width <= fill_width \0%
		<= Stamp $mol_view
			sub /
				<= stamp \
		<= Node $bog_gram_sound_node
			uri <= uri
			ended? <=> ended? null
	Play_icon $mol_icon_play
	Pause_icon $mol_icon_pause

$bog_gram_sound_node $mol_view
	dom_name \audio
	uri \
	retime? null
	ended? null
	attr *
		^
		src <= uri
		preload \metadata
	event *
		^
		timeupdate? <=> retime? null
		ended? <=> ended? null

$bog_gram_zoom $mol_view
	uri \
	close? null
	attr *
		^
		tabindex <= tab_index 0
	event *
		^
		click? <=> close? null
	plugins /
		<= Hotkey $mol_hotkey
			key * escape? <=> close? null
	sub /
		<= Shot $mol_image
			uri <= uri
