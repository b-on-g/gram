$bog_gram_settings $bog_gram_page
	title @ \Settings
	user_name? \
	link_unknown @ \Link not recognized: a Gram link to a person, group or registry is needed
	my_lord \
	invite_link \
	notify_status \
	notify_label \
	notify_supported false
	notify_toggle? null
	notify_on? false
	registry_ids /string
	registry_active \
	registry_uri \
	registry_name? \
	registry_make? null
	registry_title* \
	registry_status* \
	registry_joined* false
	registry_active_is* false
	registry_open*? null
	registry_join*? null
	registry_forget*? null
	close? null
	logs? null
	tools /
		<= Close $mol_button_minor
			hint @ \Close
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Install $bog_install
		<= Version $mol_labeler
			title @ \Version
			content /
				<= Version_text $mol_paragraph
					title <= version \
		<= Logs $mol_labeler
			title @ \Journal
			content /
				<= Logs_open $mol_button_minor
					title @ \Open the log of events and errors
					click? <=> logs? null
		<= Name_field $bog_gram_field
			hint @ \Your name: only your contacts see it
			value? <=> user_name?
		<= My_id $mol_labeler
			title @ \My ID
			content /
				<= My_id_text $mol_paragraph
					title <= my_lord
				<= My_id_copy $mol_button_copy
					title @ \Copy
					text <= my_lord
		<= Invite $mol_labeler
			title @ \Link to me
			content /
				<= Invite_body $mol_view
					sub /
						<= Invite_hint $mol_paragraph
							title @ \Send this link: the chat with you opens right away for the other person
						<= Invite_text $mol_paragraph
							title <= invite_link
						<= Invite_copy $mol_button_copy
							title @ \Copy
							text <= invite_link
						<= Invite_qr_box $mol_view
							sub /
								<= Invite_qr $bog_qr
									uri <= invite_link
									gradient_stops /
										\#229ED9
										\#5ED0F5
						<= Follow_hint $mol_paragraph
							title @ \Or scan someone else's QR: the chat, group or registry opens right here, not in the browser
						<= Follow $bog_gram_scan
							toggle_title @ \Scan link
							prefix \#!
							found? <=> follow? \
						<= Paste $mol_view
							sub /
								<= Paste_field $mol_string
									hint @ \Or paste an invitation link
									value? <=> paste_uri? \
									submit? <=> paste_open? null
								<= Paste_open $mol_button_major
									click? <=> paste_open? null
									sub /
										<= paste_open_label @ \Open
						<= Paste_error $mol_paragraph
							title <= paste_error? \
		<= Notify $mol_labeler
			title @ \Notifications
			content /
				<= Notify_body $mol_view
					sub /
						<= Notify_status $mol_paragraph
							title <= notify_status
						<= Notify_toggle $mol_button_major
							click? <=> notify_toggle?
							sub /
								<= notify_label
		<= Registry_block $mol_labeler
			title @ \Registries
			content <= registry_content /
		<= Account $mol_labeler
			title @ \Account
			content /
				<= Key $bog_gram_settings_key
					notify_on? <=> notify_on?
	Registry_empty $mol_paragraph
		title @ \You are not in any registry
	Registry_list $mol_list
		rows <= registry_rows /
	Registry_note $mol_paragraph
		title @ \You can only remove it from your own list: the entry in the registry itself stays forever.
	Registry_share $mol_view
		sub /
			<= Registry_share_text $mol_paragraph
				title @ \Invitation link to the active registry
			<= Registry_share_copy $mol_button_copy
				title @ \Copy link
				text <= registry_uri
	Registry_form $mol_view
		sub /
			<= Registry_name $mol_string
				hint @ \Registry name
				value? <=> registry_name?
				submit? <=> registry_make?
			<= Registry_make $mol_button_major
				click? <=> registry_make?
				sub /
					<= registry_make_label @ \Create registry
	Registry_row* $bog_gram_row
		faced false
		click? <=> registry_open*?
		current <= registry_active_is*
		title <= registry_title*
		note <= registry_status*
		tools /
			<= Registry_join* $mol_button_minor
				hint @ \Join registry
				click? <=> registry_join*?
				sub /
					<= registry_join_label* @ \Join
			<= Registry_drop* $mol_button_minor
				hint @ \Remove from your list
				click? <=> registry_forget*?
				sub /
					<= Registry_drop_icon* $mol_icon_close
