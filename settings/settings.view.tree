$bog_gram_settings $bog_gram_page
	title \Настройки
	user_name? \
	my_lord \
	invite_link \
	notify_status \
	notify_label \
	notify_supported false
	notify_toggle? null
	notify_on? false
	registry_ids /string
	registry_active \
	registry_uri \
	registry_name? \
	registry_make? null
	registry_title* \
	registry_status* \
	registry_joined* false
	registry_active_is* false
	registry_open*? null
	registry_join*? null
	registry_forget*? null
	close? null
	tools /
		<= Close $mol_button_minor
			hint \Закрыть
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Version $mol_labeler
			title \Версия
			content /
				<= Version_text $mol_paragraph
					title <= version \
		<= Name_field $bog_gram_field
			hint \Ваше имя — видят только собеседники
			value? <=> user_name?
		<= My_id $mol_labeler
			title \Мой ID
			content /
				<= My_id_text $mol_paragraph
					title <= my_lord
				<= My_id_copy $mol_button_copy
					title \Скопировать
					text <= my_lord
		<= Invite $mol_labeler
			title \Ссылка на меня
			content /
				<= Invite_body $mol_view
					sub /
						<= Invite_hint $mol_paragraph
							title \Отправьте эту ссылку — у собеседника сразу откроется диалог с вами
						<= Invite_text $mol_paragraph
							title <= invite_link
						<= Invite_copy $mol_button_copy
							title \Скопировать
							text <= invite_link
						<= Invite_qr_box $mol_view
							sub /
								<= Invite_qr $bog_qr
									uri <= invite_link
									gradient_stops /
										\#229ED9
										\#5ED0F5
						<= Follow_hint $mol_paragraph
							title \Или отсканируйте чужой QR: диалог, группа или реестр откроются прямо здесь, а не в браузере
						<= Follow $bog_gram_scan
							toggle_title \Сканировать ссылку
							prefix \#!
							found? <=> follow? \
						<= Paste $mol_view
							sub /
								<= Paste_field $mol_string
									hint \Или вставьте ссылку-приглашение
									value? <=> paste_uri? \
									submit? <=> paste_open? null
								<= Paste_open $mol_button_major
									click? <=> paste_open? null
									sub /
										\Открыть
						<= Paste_error $mol_paragraph
							title <= paste_error? \
		<= Notify $mol_labeler
			title \Уведомления
			content /
				<= Notify_body $mol_view
					sub /
						<= Notify_status $mol_paragraph
							title <= notify_status
						<= Notify_toggle $mol_button_major
							click? <=> notify_toggle?
							sub /
								<= notify_label
		<= Registry_block $mol_labeler
			title \Реестры
			content <= registry_content /
		<= Account $mol_labeler
			title \Аккаунт
			content /
				<= Key $bog_gram_settings_key
					notify_on? <=> notify_on?
	Registry_empty $mol_paragraph
		title \Вы не состоите ни в одном реестре
	Registry_list $mol_list
		rows <= registry_rows /
	Registry_note $mol_paragraph
		title \Убрать можно только из своего списка: запись в самом реестре остаётся навсегда.
	Registry_share $mol_view
		sub /
			<= Registry_share_text $mol_paragraph
				title \Ссылка-приглашение в активный реестр
			<= Registry_share_copy $mol_button_copy
				title \Скопировать ссылку
				text <= registry_uri
	Registry_form $mol_view
		sub /
			<= Registry_name $mol_string
				hint \Название реестра
				value? <=> registry_name?
				submit? <=> registry_make?
			<= Registry_make $mol_button_major
				click? <=> registry_make?
				sub /
					\Создать реестр
	Registry_row* $bog_gram_row
		faced false
		click? <=> registry_open*?
		current <= registry_active_is*
		title <= registry_title*
		note <= registry_status*
		tools /
			<= Registry_join* $mol_button_minor
				hint \Вступить в реестр
				click? <=> registry_join*?
				sub /
					\Вступить
			<= Registry_drop* $mol_button_minor
				hint \Убрать из своего списка
				click? <=> registry_forget*?
				sub /
					<= Registry_drop_icon* $mol_icon_close
