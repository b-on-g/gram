$bog_gram_bubble $mol_view
	out false
	menu false
	author \
	author_tint 0
	quote_shown false
	quote_author \
	quote_text \
	quote_jump? null
	shot false
	shots /string
	shot_uri* \
	shot_ratio* 1
	shot_width \
	shot_open*? null
	sound false
	sound_uri \
	sound_span 0
	sound_playing false
	sound_toggle? null
	sound_ended? null
	video false
	video_uri \
	video_ratio 1.78
	call false
	call_land null
	call_open? null
	forwarded false
	contact false
	contact_name \
	contact_open? null
	forwardable true
	forward? null
	body \
	time \
	edited false
	checks \
	edit? null
	delete? null
	press? null
	release? null
	context? null
	attr *
		^
		bog_gram_bubble_out <= out
		bog_gram_bubble_menu <= menu
	event *
		^
		pointerdown? <=> press?
		pointerup? <=> release?
		pointercancel? <=> release?
		contextmenu? <=> context?
		mousedown? <=> mouse_down? null
	sub /
		<= Author $mol_view
			attr *
				^
				bog_gram_tint <= author_tint
			sub /
				<= author
		<= Forwarded $mol_view
			sub /
				<= Forwarded_icon $mol_icon_share
				<= forwarded_label @ \Forwarded
		<= Quote $mol_button_minor
			hint @ \Go to message
			click? <=> quote_jump?
			sub /
				<= Quote_author $mol_view
					sub /
						<= quote_author
				<= Quote_text $mol_view
					sub /
						<= quote_text
		<= Shot $bog_gram_album
			shots <= shots
			uri* <= shot_uri*
			ratio* <= shot_ratio*
			width <= shot_width
			open*? <=> shot_open*?
		<= Sound $bog_gram_sound
			uri <= sound_uri
			span <= sound_span
			playing <= sound_playing
			toggle? <=> sound_toggle?
			ended? <=> sound_ended?
		<= Clip $mol_video_player
			uri <= video_uri
			autoplay false
			style *
				^
				aspectRatio <= video_ratio
		<= Call $bog_gram_call_card
			land <= call_land
			click? <=> call_open?
		<= Contact $mol_view
			sub /
				<= Contact_icon $mol_icon_account
				<= Contact_name $mol_view
					sub /
						<= contact_name
				<= Contact_open $mol_button_minor
					click? <=> contact_open?
					title @ \Write
		<= Line $mol_view
			sub /
				<= Body $bog_gram_body
					text <= body
				<= Meta $mol_view
					sub /
						<= Time $mol_view
							sub /
								<= time
						<= Edited $mol_view
							sub /
								<= edited_label @ \edited
						<= Checks $mol_view
							sub /
								<= checks
		<= Actions $mol_view
			event *
				^
				pointerdown? <=> actions_touch? null
				pointerup? <=> actions_touch? null
			sub /
				<= Copy $mol_button_copy
					hint @ \Copy text
					text <= body
					title \
				<= Forward $mol_button_minor
					hint @ \Forward
					click? <=> forward?
					sub /
						<= Forward_icon $mol_icon_share
				<= Edit $mol_button_minor
					hint @ \Edit
					click? <=> edit?
					sub /
						<= Edit_icon $mol_icon_pencil
				<= Delete $mol_button_minor
					hint @ \Delete
					click? <=> delete?
					sub /
						<= Delete_icon $mol_icon_delete
