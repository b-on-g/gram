$bog_gram_bubble $mol_view
	out false
	menu false
	last false
	author \
	author_tint 0
	quote_shown false
	quote_author \
	quote_text \
	quote_jump? null
	shot false
	shots /string
	shot_uri* \
	shot_ratio* 1
	shot_width \
	shot_open*? null
	sound false
	sound_uri \
	sound_span 0
	sound_wave \
	sound_playing false
	sound_toggle? null
	sound_ended? null
	round false
	round_uri \
	round_span 0
	round_toggle? null
	round_ended? null
	video false
	video_uri \
	video_ratio 1.78
	call false
	call_land null
	call_open? null
	forwarded false
	contact false
	contact_name \
	contact_open? null
	task? false
	task_done? false
	reactions /string
	react? \
	react_open? false
	forwardable true
	forward? null
	content null
	time \
	edited false
	checks \
	edit? null
	delete? null
	press? null
	release? null
	context? null
	attr *
		^
		bog_gram_bubble_out <= out
		bog_gram_bubble_menu <= menu
		bog_gram_bubble_last <= last
		bog_gram_bubble_bare <= bare false
		bog_gram_bubble_done <= done false
	event *
		^
		pointerdown? <=> press?
		pointerup? <=> release?
		pointercancel? <=> release?
		contextmenu? <=> context?
		mousedown? <=> mouse_down? null
	sub /
		<= Author $mol_view
			attr *
				^
				bog_gram_tint <= author_tint
			sub /
				<= author
		<= Forwarded $mol_view
			sub /
				<= Forwarded_icon $mol_icon_share
				<= forwarded_label @ \Forwarded
		<= Task $mol_check_box
			title @ \Task
			checked? <=> task_done?
			event *
				^
				pointerdown? <=> actions_touch? null
				pointerup? <=> actions_touch?
		<= Quote $mol_button_minor
			hint @ \Go to message
			click? <=> quote_jump?
			sub /
				<= Quote_author $mol_view
					sub /
						<= quote_author
				<= Quote_text $mol_view
					sub /
						<= quote_text
		<= Shot $bog_gram_album
			shots <= shots
			uri* <= shot_uri*
			ratio* <= shot_ratio*
			width <= shot_width
			open*? <=> shot_open*?
		<= Sound $bog_gram_sound
			uri <= sound_uri
			span <= sound_span
			wave <= sound_wave
			playing <= sound_playing
			toggle? <=> sound_toggle?
			ended? <=> sound_ended?
		<= Round $bog_gram_round
			uri <= round_uri
			span <= round_span
			playing <= sound_playing
			toggle? <=> round_toggle?
			ended? <=> round_ended?
		<= Clip $mol_video_player
			uri <= video_uri
			autoplay false
			style *
				^
				aspectRatio <= video_ratio
		<= Call $bog_gram_call_card
			land <= call_land
			click? <=> call_open?
		<= Contact $mol_view
			sub /
				<= Contact_icon $mol_icon_account
				<= Contact_name $mol_view
					sub /
						<= contact_name
				<= Contact_open $mol_button_minor
					click? <=> contact_open?
					title @ \Write
		<= Line $mol_view
			sub /
				<= Body $bog_rich_render
					content <= content
					shown_text => copy_text
					shown_html => copy_html
				<= Meta $mol_view
					sub /
						<= Time $mol_view
							sub /
								<= time
						<= Edited $mol_view
							sub /
								<= edited_label @ \edited
						<= Checks $mol_view
							sub /
								<= checks
				<= Actions $mol_view
					event *
						^
						pointerdown? <=> actions_touch?
						pointerup? <=> actions_touch?
					sub /
						<= React $mol_check_icon
							hint @ \React
							checked? <=> react_open?
							Icon <= React_icon $mol_icon_emoticon_outline
						<= Copy $mol_button_copy
							hint @ \Copy text
							text <= copy_text
							html <= copy_html
							title \
						<= Task_mark $mol_check_icon
							hint @ \Task
							checked? <=> task?
							Icon <= Task_mark_icon $mol_icon_format_list_checks
						<= Forward $mol_button_minor
							hint @ \Forward
							click? <=> forward?
							sub /
								<= Forward_icon $mol_icon_share
						<= Edit $mol_button_minor
							hint @ \Edit
							click? <=> edit?
							sub /
								<= Edit_icon $mol_icon_pencil
						<= Delete $mol_button_minor
							hint @ \Delete
							click? <=> delete?
							sub /
								<= Delete_icon $mol_icon_delete
		<= Reactions $mol_view
			event *
				^
				pointerdown? <=> actions_touch?
				pointerup? <=> actions_touch?
			sub <= reaction_chips /$mol_view
		<= Palette $mol_view
			event *
				^
				pointerdown? <=> actions_touch?
				pointerup? <=> actions_touch?
			sub <= palette_picks /$mol_view
	Reaction* $mol_button_minor
		hint @ \Reaction
		attr *
			^
			bog_gram_bubble_mine <= reaction_mine* false
		click? <=> reaction_toggle*? null
		sub /
			<= reaction_label* \
	Pick* $mol_button_minor
		hint @ \Reaction
		attr *
			^
			bog_gram_bubble_mine <= reaction_mine*
		click? <=> reaction_toggle*?
		sub /
			<= pick_label* \
