$bog_gram_write $giper_baza_rich_edit
	html? \
	rich false
	length_max +Infinity
	send? null
	attr *
		^
		bog_gram_write_rich <= rich
	event *
		^
		keydown? <=> press? null
		beforeinput? <=> before_input? null
		mousedown? <=> tools_hold? null
		touchstart? <=> tools_touch? null
		touchend? <=> tools_tap? null
		focusout? <=> tools_leave? null
	Hint $mol_view
		sub /
			<= hint
