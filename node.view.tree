	land null
	Room $bog_gram_call_room
		land <= land
	sub /
		<= Icon $mol_icon_phone
		<= Info $mol_view
			sub /
				<= Title $mol_view
					sub /
						<= title @ \Звонок
				<= Count $mol_view
					sub /
						<= count_text \
	count_none @ \Сейчас никого, нажмите, чтобы войти
	count_some @ \В звонке: {count}

$bog_gram_bubble $mol_view
	out false
	menu false
	author \
	author_tint 0
	quote_shown false
	quote_author \
	quote_text \
	quote_jump? null
	shot false
	shot_uri \
	shot_width \
	shot_ratio \
	zoom? null
	sound false
	sound_uri \
	sound_span 0
	sound_playing false
	sound_toggle? null
	sound_ended? null
	call false
	call_land null
	call_open? null
	body \
	time \
	edited false
	checks \
	edit? null
	delete? null
	press? null
	release? null
	context? null
	attr *
		^
		bog_gram_bubble_out <= out
		bog_gram_bubble_menu <= menu
	event *
		^
		pointerdown? <=> press?
		pointerup? <=> release?
		pointercancel? <=> release?
		contextmenu? <=> context?
		mousedown? <=> mouse_down? null
	sub /
		<= Author $mol_view
			attr *
				^
				bog_gram_tint <= author_tint
			sub /
				<= author
		<= Quote $mol_button_minor
			hint \Перейти к сообщению
			click? <=> quote_jump?
			sub /
				<= Quote_author $mol_view
					sub /
						<= quote_author
				<= Quote_text $mol_view
					sub /
						<= quote_text
		<= Shot $bog_gram_photo
			hint \Открыть картинку
			uri <= shot_uri
			box_width <= shot_width
			box_ratio <= shot_ratio
			click? <=> zoom?
		<= Sound $bog_gram_sound
			uri <= sound_uri
			span <= sound_span
			playing <= sound_playing
			toggle? <=> sound_toggle?
			ended? <=> sound_ended?
		<= Call $bog_gram_call_card
			land <= call_land
			click? <=> call_open?
		<= Body $mol_paragraph
			title <= body
		<= Meta $mol_view
			sub /
				<= Time $mol_view
					sub /
						<= time
				<= Edited $mol_view
					sub /
						\изменено
				<= Checks $mol_view
					sub /
						<= checks
		<= Actions $mol_view
			event *
				^
				pointerdown? <=> actions_touch? null
				pointerup? <=> actions_touch? null
			sub /
				<= Edit $mol_button_minor
					hint \Редактировать
					click? <=> edit?
					sub /
						<= Edit_icon $mol_icon_pencil
				<= Delete $mol_button_minor
					hint \Удалить
					click? <=> delete?
					sub /
						<= Delete_icon $mol_icon_delete

$bog_gram_chat $bog_gram_page
	dialog \
	my_lord \
	Talk $bog_gram_talk
	People $bog_gram_people
	Alerts $bog_gram_alerts
	close? null
	members? null
	call_open? null
	note? \
	note_hint \
	note_editable false
	members_shown false
	edit_mode false
	reply_mode false
	reply_title \
	reply_text \
	message_text? \
	zoom_uri \
	voice_ready false
	voice_on false
	voice_clock \
	voice_hint? \
	edit_id? \
	reply_id? \
	message_menu? \
	zoom_id? \
	voice_start? 0
	voice_playing? \
	stick_end? false
	rows_seen? 0
	event *
		^
		paste? <=> image_paste? null
		dragover? <=> image_over? null
		drop? <=> image_drop? null
	plugins /
		<= Hotkey $mol_hotkey
			key * escape? <=> zoom_close? null
	Zoom $bog_gram_zoom
		uri <= zoom_uri
		close? <=> zoom_close?
	title_content /
		<= Note_field $bog_gram_field
			hint <= note_hint
			value? <=> note?
		<= Title_text $mol_view
			sub /
				<= title
	head /
		<= Back $mol_button_minor
			hint \Назад
			click? <=> close?
			sub /
				<= Back_icon $mol_icon_arrow_left
		<= Title
		<= Tools
	tools /
		<= Call $mol_button_minor
			hint \Звонок
			click? <=> call_start? null
			sub /
				<= Call_icon $mol_icon_phone
		<= Members $mol_button_minor
			hint \Участники
			click? <=> members?
			sub /
				<= Members_icon $mol_icon_account_multiple
		<= Close $mol_button_minor
			hint \Закрыть
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Messages $mol_list
			rows <= rows /$mol_view
	foot /
		<= Reply_banner $mol_view
			sub /
				<= Reply_icon $mol_icon_reply
				<= Reply_info $mol_view
					sub /
						<= Reply_title $mol_view
							sub /
								<= reply_title
						<= Reply_text $mol_view
							sub /
								<= reply_text
				<= Reply_cancel $mol_button_minor
					hint \Отменить ответ
					click? <=> reply_cancel? null
					sub /
						<= Reply_cancel_icon $mol_icon_close
		<= Edit_banner $mol_view
			sub /
				<= Edit_banner_text $mol_paragraph
					title \Редактирование
				<= Edit_cancel $mol_button_minor
					hint \Отменить правку
					click? <=> edit_cancel? null
					sub /
						<= Edit_cancel_icon $mol_icon_close
		<= Voice_note $mol_paragraph
			title <= voice_hint
		<= Send_row $mol_view
			sub <= send_tools /
	Attach $bog_gram_attach
		hint \Отправить картинку
		accept \image/*
		multiple false
		files? <=> image_files? null
		Icon <= Attach_icon $mol_icon_paperclip
	Message_field $mol_string
		hint \Сообщение…
		value? <=> message_text?
		submit? <=> message_send? null
	Send $mol_button_major
		hint \Отправить
		click? <=> message_send?
		sub /
			<= Send_icon $mol_icon_send
	Voice $bog_gram_hold
		hint \Удерживайте для записи
		press? <=> voice_press? null
		release? <=> voice_release? null
		abort? <=> voice_cancel? null
		sub /
			<= Voice_icon $mol_icon_microphone
	Record_state $mol_view
		sub /
			<= Record_dot $mol_view
			<= Record_time $mol_view
				sub /
					<= voice_clock
	Voice_cancel $mol_button_minor
		hint \Отпустите здесь, чтобы отменить
		click? <=> voice_cancel?
		sub /
			<= Voice_cancel_icon $mol_icon_close
			<= Voice_cancel_text $mol_view
				sub /
					\Отмена
	Line* $mol_view
		minimal_height 48
		sub <= line_content* /
	Day_row* $mol_view
		sub /
			<= Day_chip* $mol_view
				sub /
					<= day_title* \
	Bubble* $bog_gram_bubble
		out <= message_out* false
		menu <= message_menu_is* false
		author <= message_author* \
		author_tint <= message_author_tint* 0
		quote_shown <= message_quote_shown* false
		quote_author <= message_quote_author* \
		quote_text <= message_quote_text* \
		quote_jump? <=> message_quote_jump*? null
		shot <= message_shot* false
		shot_uri <= message_shot_uri* \
		shot_width <= message_shot_width* \
		shot_ratio <= message_shot_ratio* \
		zoom? <=> message_zoom*? null
		sound <= message_sound* false
		sound_uri <= message_sound_uri* \
		sound_span <= message_sound_span* 0
		sound_playing <= message_sound_playing* false
		sound_toggle? <=> message_sound_toggle*? null
		sound_ended? <=> message_sound_ended*? null
		call <= message_call* false
		call_land <= message_call_land* null
		call_open? <=> message_call_open*? null
		body <= message_body* \
		time <= message_time* \
		edited <= message_edited* false
		checks <= message_checks* \
		edit? <=> message_edit*? null
		delete? <=> message_delete*? null
		press? <=> message_press*? null
		release? <=> message_release*? null
		context? <=> message_context*? null

$bog_gram $mol_book2
	plugins /
		<= Skin $bog_builderui_skin
			lights <= lights \system
			base \zinc
			font_head \eb-garamond
		<= Theme $bog_theme_auto
	Account $bog_gram_account
		my_lord => my_lord
		my_pass => my_pass
		user_name? => user_name?
		dialogs_store => dialogs_store
		monitor_store => monitor_store
		monitor_link => monitor_link
		ready => account_ready
	Registry $bog_gram_registry
		Account <= Account
		ids => registry_ids
		active => registry_active
		title* => registry_title*
		status* => registry_status*
		joined* => registry_joined*
		active_is* => registry_active_is*
		uri => registry_uri
		name? => registry_name?
		make? => registry_make?
		open*? => registry_open*?
		join*? => registry_join*?
		join_active? => registry_join_active?
		forget*? => registry_forget*?
		join_needed => registry_join_needed
		sources => user_sources
		people => user_lords
		source_title* => user_source*
		remember => registry_remember
		keys_fill => registry_keys_fill
	People $bog_gram_people
		Account <= Account
		Registry <= Registry
		Roster <= Roster
		name* => peer_name*
		note* => peer_note*
		label* => peer_label*
		known* => peer_known*
		accept* => peer_accept*
		pass_of* => peer_pass_of*
	Talk $bog_gram_talk
		Account <= Account
		People <= People
		saved_title => saved_title
		saved_id => saved_id
		saved_links => saved_links
		saved_is* => saved_is*
		saved_land => saved_land
		store* => dialog_store*
		lords* => dialog_lords*
		mates* => dialog_mates*
		peer* => dialog_peer*
		group_title* => group_title*
		group_is* => group_is*
		group_name_auto* => group_name_auto*
		admins* => admin_lords*
		admin_me* => admin_me*
		owner* => dialog_owner*
		own* => dialog_own*
		title* => dialog_title*
		avatar_id* => dialog_avatar_id*
		tint* => dialog_tint*
		moment* => dialog_moment*
		alive* => dialog_alive*
		links_of* => session_links_of*
		land* => session_land_by*
		lands_of* => session_lands_of*
		land_of* => session_land_of*
		session* => session_store_last*
		messages_of* => messages_of*
		messages_alive_of* => messages_alive_of*
		unread* => unread_total*
		preview* => dialog_preview*
		time* => dialog_time*
		mine_wrote* => mine_wrote*
	Roster $bog_gram_roster
		Account <= Account
		People <= People
		Talk <= Talk
		ids => dialog_ids
		hidden => hidden_ids
		kind* => dialog_kind*
		requests => request_ids
		archived => archive_ids
		archive_is* => archive_is*
		visible => dialog_visible
		with* => dialog_with*
		watch_fill => monitor_fill
		names_fill => names_fill
		contact_lords => contact_lords
		contact_source* => contact_source*
	Crew $bog_gram_crew
		Account <= Account
		People <= People
		Talk <= Talk
		error? => member_error?
		history? => member_history?
		draft_name? => group_name?
		draft_picked => group_picked
		draft_lost => group_lost
		draft_id? => group_id?
		draft_error => group_id_error
		draft_pick*? => group_pick*?
		draft_drop*? => group_chosen_drop*?
		draft_id_add? => group_id_add?
	Lobby $bog_gram_lobby
		Account <= Account
		People <= People
		Talk <= Talk
		Roster <= Roster
		Crew <= Crew
		outbox_flush => outbox_flush
		asks_flush => asks_flush
		plate => ask_plate_text
		lord_of* => ask_lord*
	Invite $bog_gram_invite
		Account <= Account
		People <= People
		Roster <= Roster
		link => invite_link
		plate => invite_plate_text
		pending? => dialog_pending?
		drop? => invite_drop?
		timer => pending_timer
	Alerts $bog_gram_alerts
		Account <= Account
		supported => notify_supported
		status => notify_status
		label => notify_label
		toggle? => notify_toggle?
		on? => notify_on?
		auto => notify_auto
	Placeholder <= Intro $mol_view
		sub /
			<= Intro_plate $mol_view
				sub /
					<= Intro_title $mol_paragraph
						title \Выберите диалог
					<= Intro_hint $mol_paragraph
						title \Или начните новый: кнопка в шапке списка
	pages /
		<= Menu $bog_gram_menu
			Theme <= Theme
			compose? <=> compose_open? null
			group? <=> group_open? null
			music? <=> music_open? null
			settings? <=> settings_open? null
			invite_plate_text <= invite_plate_text
			invite_drop? <=> invite_drop?
			ask_plate_text <= ask_plate_text
			visible <= dialog_visible
			archived <= archive_fresh /string
			requests <= request_ids
			dialog_title* <= dialog_title*
			dialog_time* <= dialog_time*
			dialog_preview* <= dialog_preview*
			dialog_avatar_id* <= dialog_avatar_id*
			dialog_tint* <= dialog_tint*
			unread* <= unread_count* 0
			current_is* <= dialog_current_is* false
			request_is* <= request_is* false
			archive_is* <= archive_is*
			select*? <=> dialog_select*? null
			archive*? <=> dialog_archive*? null
			unarchive*? <=> dialog_unarchive*? null
			drop*? <=> dialog_delete*? null
			accept*? <=> request_accept*? null
			saved_title <= saved_title
			saved_time <= saved_time \
			saved_preview <= saved_preview \
			saved_current <= saved_current_is false
			saved_open? <=> saved_open? null
		<= Music_page $bog_gram_music
			hidden <= music_hidden false
			close? <=> music_close? null
		<= Settings_page $bog_gram_settings
			close? <=> settings_close? null
			user_name? <=> user_name?
			my_lord <= my_lord
			invite_link <= invite_link
			notify_status <= notify_status
			notify_label <= notify_label
			notify_supported <= notify_supported
			notify_toggle? <=> notify_toggle?
			notify_on? <=> notify_on?
			registry_ids <= registry_ids
			registry_active <= registry_active
			registry_uri <= registry_uri
			registry_name? <=> registry_name?
			registry_make? <=> registry_make?
			registry_title* <= registry_title*
			registry_status* <= registry_status*
			registry_joined* <= registry_joined*
			registry_active_is* <= registry_active_is*
			registry_open*? <=> registry_open*?
			registry_join*? <=> registry_join*?
			registry_forget*? <=> registry_forget*?
		<= Compose_page $bog_gram_compose
			close? <=> compose_close? null
			open*? <=> dialog_open*? null
			users <= user_lords
			user_title* <= peer_label*
			user_source* <= user_source*
			registry_ids <= registry_ids
			join_needed <= registry_join_needed
			join? <=> registry_join_active?
		<= Group_page $bog_gram_group
			close? <=> group_close? null
			make? <=> group_make? null
			name? <=> group_name?
			picked <= group_picked
			lost <= group_lost
			id? <=> group_id?
			id_error <= group_id_error
			pick*? <=> group_pick*?
			drop*? <=> group_chosen_drop*?
			id_add? <=> group_id_add?
			label* <= peer_label*
			contact_lords <= contact_lords
			contact_source* <= contact_source*
		<= Members_page $bog_gram_members
			close? <=> members_close? null
			me <= my_lord
			lords <= member_lords /string
			label* <= peer_label*
			status* <= member_status* \
			admin <= members_admin false
			owner <= members_owner false
			admin_is* <= member_admin* false
			error? <=> member_error?
			join_link <= join_link \
			asks <= members_asks /string
			ask_lord* <= ask_lord*
			accept*? <=> ask_accept*? null
			reject*? <=> ask_reject*? null
			candidates <= member_candidates /string
			contact_source* <= contact_source*
			history? <=> member_history?
			add*? <=> member_add*? null
			part*? <=> member_drop*? null
			promote*? <=> member_raise*? null
			leave? <=> group_leave? null
	Chat_page* $bog_gram_chat
		dialog <= chat_dialog* \
		my_lord <= my_lord
		Talk <= Talk
		People <= People
		Alerts <= Alerts
		close? <=> dialog_close? null
		members? <=> members_open? null
		call_open? <=> call_open? null
	Call_page* $bog_gram_call
		land <= call_land* null
		name <= user_name
		tools /
			<= Call_close* $mol_button_minor
				hint \Закрыть
				click? <=> call_close? null
				sub /
					<= Call_close_icon* $mol_icon_close
