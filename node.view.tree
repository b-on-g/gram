$mol_check_icon $mol_check

$bog_gram_call $mol_page
	land null
	name \
	Room $bog_gram_call_room
		land <= land
		name <= name
	title @ \Звонок
	body <= content /
	foot <= controls /
	Grid $mol_view
		sub <= tiles /
	Self $bog_gram_call_tile
		stream <= self_stream null
		muted true
		mirror true
		cam <= cam
		mic <= mic
		name <= self_name @ \Вы
	Mate* $bog_gram_call_tile
		stream <= mate_stream* null
		cam <= mate_cam* true
		mic <= mate_mic* true
		name <= mate_name* \
		status <= mate_status* \
