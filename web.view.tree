		<= String $mol_string
			type \text
			keyboard \decimal
			value? <=> value_string? \
			hint <= hint \ 
			enabled <= string_enabled <= enabled
			submit? <=> submit? null
			selection? <=> selection? /number
		<= Decrement $mol_button_minor
			click? <=> decrement? null
