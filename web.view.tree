		<= Field $mol_string_button
			hint <= hint
			value? <=> value?
		<= Edit_icon $mol_icon_pencil

$bog_qr $mol_svg_root
	uri \
	module_radius 0.35
	finder_radius 1.2
	gradient_angle 45
	error_correction \M
	quiet_zone 2
	center /
	gradient_id \qr-grad
	gradient_fill \url(#qr-grad)
	gradient_stops /
		\var(--mol_theme_special)
		\var(--mol_theme_focus)
	Stop* $mol_svg
		dom_name \stop
		attr *
			^
			offset <= stop_offset* \0%
			stop-color <= stop_color* \
	view_box <= qr_view_box \0 0 1 1
	sub /
		<= Defs $mol_svg
			dom_name \defs
			sub /
				<= Gradient $mol_svg
					dom_name \linearGradient
					attr *
						^
						id <= gradient_id
						x1 <= grad_x1 \0
						y1 <= grad_y1 \0
						x2 <= grad_x2 \1
						y2 <= grad_y2 \1
					sub <= gradient_stop_list /
		<= Modules $mol_svg_path
			geometry <= modules_d \
			attr *
				^
				fill <= gradient_fill
		<= Rings $mol_svg_path
			geometry <= rings_d \
			attr *
				^
				fill <= gradient_fill
				fill-rule \evenodd
		<= Centers $mol_svg_path
			geometry <= centers_d \
			attr *
				^
				fill <= gradient_fill
		<= Center_wrap $mol_svg
			dom_name \foreignObject
			attr *
				^
				x <= center_x \0
				y <= center_y \0
				width <= center_size \0
				height <= center_size
			sub /
				<= Center_body $mol_view
					sub <= center

$mol_video_player $mol_view
	dom_name \video
	playing? false
	play null
	pause null
	volume? 0
	time? 0
	duration 0
	attr *
		src <= uri \
		controls <= controls true
		autoplay <= autoplay true
		playsinline <= inline true
		loop <= loop false
		muted <= muted false
		poster <= poster \
	field *
		srcObject <= stream null
	event *
		volumechange? <=> revolume? null
		timeupdate? <=> retime? null
		durationchange? <=> redurate? null
		playing? <=> playing_event? null
		play? <=> play_event? null
		pause? <=> pause_event? null

$mol_video_camera $mol_video_player
	controls false
	style *
		transform <= transform \
	video_constraints *
		facingMode <= facing \user
		aspectRatio <= aspect 1
		width * ideal <= width <= size 720
		height * ideal <= height <= size
	video_settings *
		brightness <= brightness 128
		sharpness <= sharpness 2
		contrast <= contrast 32
		saturation <= saturation 64
		advanced /
			* colorTemperature <= temperature 4000
			* torch <= torch false


$bog_gram_scan $mol_view
	scanning? false
	prefix \
	found? \
	sub /
		<= Toggle $mol_check
			title <= toggle_title @ \Сканировать QR
			checked? <=> scanning?
		<= Camera $mol_video_camera
			facing \environment
			muted true

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$bog_gram_settings_key $mol_view
	notify_on? false
	sub <= rows /
	Toggle $mol_button_minor
		click? <=> toggle? null
		sub /
			<= toggle_label \
	Warning $mol_paragraph
		title \Ключ — это полный доступ к аккаунту. Не показывайте его никому и не публикуйте.
	Row $mol_view
		sub /
			<= Text $mol_paragraph
				title <= text \
			<= Copy $mol_button_copy
				title \Скопировать
				text <= text
	Qr_box $mol_view
		sub /
			<= Qr $bog_qr
				uri <= text
				gradient_stops /
					\#e14b4b
					\#f0a04b
	Save $mol_button_download
		title \Скачать файл
		file_name \gram-account.key
		blob <= blob null Blob
	Import_form $mol_view
		sub /
			<= Field $mol_string
				hint \Ключ аккаунта
				value? <=> input? \
			<= Load_row $mol_view
				sub /
					<= Load_hint $mol_paragraph
						title \Или загрузите файл с ключом
					<= Open $mol_button_open
						hint \Выбрать файл
						accept \.key,text/plain
						multiple false
						files? <=> file? null
			<= Scan $bog_gram_scan
				found? <=> scanned? \
			<= Import $mol_button_major
				attr *
					^
					bog_gram_armed <= armed? false
				click? <=> import? null
				sub /
					<= import_label \
			<= Error $mol_paragraph
				title <= error? \

$bog_gram_settings $bog_gram_page
	title \Настройки
