				sub /
					<= Intro_title $mol_paragraph
						title \Выберите диалог
					<= Intro_hint $mol_paragraph
						title \Или начните новый: кнопка в шапке списка
	pages /
		<= Menu $bog_gram_menu
			Theme <= Theme
			compose? <=> compose_open? null
			group? <=> group_open? null
			music? <=> music_open? null
			settings? <=> settings_open? null
			invite_plate_text <= invite_plate_text
			invite_drop? <=> invite_drop?
			ask_plate_text <= ask_plate_text
			visible <= dialog_visible
			archived <= archive_fresh /string
			requests <= request_ids
			dialog_title* <= dialog_title*
			dialog_time* <= dialog_time*
			dialog_preview* <= dialog_preview*
			dialog_avatar_id* <= dialog_avatar_id*
			dialog_tint* <= dialog_tint*
			unread* <= unread_count* 0
			current_is* <= dialog_current_is* false
			request_is* <= request_is* false
			archive_is* <= archive_is*
			select*? <=> dialog_select*? null
			archive*? <=> dialog_archive*? null
			unarchive*? <=> dialog_unarchive*? null
			drop*? <=> dialog_delete*? null
			accept*? <=> request_accept*? null
			saved_title <= saved_title
			saved_time <= saved_time \
			saved_preview <= saved_preview \
			saved_current <= saved_current_is false
			saved_open? <=> saved_open? null
		<= Music_page $bog_gram_music
			hidden <= music_hidden false
			close? <=> music_close? null
		<= Settings_page $bog_gram_settings
			close? <=> settings_close? null
			user_name? <=> user_name?
			my_lord <= my_lord
			invite_link <= invite_link
			notify_status <= notify_status
			notify_label <= notify_label
			notify_supported <= notify_supported
			notify_toggle? <=> notify_toggle?
			notify_on? <=> notify_on?
			registry_ids <= registry_ids
			registry_active <= registry_active
			registry_uri <= registry_uri
			registry_name? <=> registry_name?
			registry_make? <=> registry_make?
			registry_title* <= registry_title*
			registry_status* <= registry_status*
			registry_joined* <= registry_joined*
			registry_active_is* <= registry_active_is*
			registry_open*? <=> registry_open*?
			registry_join*? <=> registry_join*?
			registry_forget*? <=> registry_forget*?
		<= Compose_page $bog_gram_compose
			close? <=> compose_close? null
			open*? <=> dialog_open*? null
			users <= user_lords
			user_title* <= peer_label*
			user_source* <= user_source*
			registry_ids <= registry_ids
			join_needed <= registry_join_needed
			join? <=> registry_join_active?
		<= Group_page $bog_gram_group
			close? <=> group_close? null
			make? <=> group_make? null
			name? <=> group_name?
			picked <= group_picked
			lost <= group_lost
			id? <=> group_id?
			id_error <= group_id_error
			pick*? <=> group_pick*?
			drop*? <=> group_chosen_drop*?
			id_add? <=> group_id_add?
			label* <= peer_label*
			contact_lords <= contact_lords
			contact_source* <= contact_source*
		<= Members_page $bog_gram_members
			close? <=> members_close? null
			me <= my_lord
			lords <= member_lords /string
			label* <= peer_label*
			status* <= member_status* \
			admin <= members_admin false
			owner <= members_owner false
			admin_is* <= member_admin* false
			error? <=> member_error?
			join_link <= join_link \
			asks <= members_asks /string
			ask_lord* <= ask_lord*
			accept*? <=> ask_accept*? null
			reject*? <=> ask_reject*? null
			candidates <= member_candidates /string
			contact_source* <= contact_source*
			history? <=> member_history?
			add*? <=> member_add*? null
			part*? <=> member_drop*? null
			promote*? <=> member_raise*? null
			leave? <=> group_leave? null
	Chat_page* $bog_gram_chat
		dialog <= chat_dialog* \
		my_lord <= my_lord
		Talk <= Talk
		People <= People
		Alerts <= Alerts
		close? <=> dialog_close? null
		members? <=> members_open? null
		call_open? <=> call_open? null
	Call_page* $bog_gram_call
		land <= call_land* null
		name <= user_name
		tools /
			<= Call_close* $mol_button_minor
				hint \Закрыть
				click? <=> call_close? null
				sub /
					<= Call_close_icon* $mol_icon_close
