$bog_gram_members $bog_gram_page
	title @ \Members
	close? null
	me \
	lords /string
	label* \
	status* \
	admin false
	owner false
	admin_is* false
	error? \
	join_link \
	asks /string
	ask_lord* \
	accept*? null
	reject*? null
	candidates /string
	contact_source* \
	history? true
	self_name @ \You
	drop_hint_armed @ \Really remove? Past messages will stay with them
	drop_hint_idle @ \Remove from group
	history_all_note @ \The new member will get keys to all past group messages
	history_new_note @ \We will start a new chat compartment: the past stays closed, and everyone will see only what is written next
	error_self @ \This is your own identifier
	error_bad @ \This does not look like an identifier
	asks_pattern @ \Requests: {count}
	leave_sure @ \Really leave?
	leave_idle @ \Leave group
	add*? null
	part*? null
	promote*? null
	leave? null
	tools /
		<= Close $mol_button_minor
			hint @ \Close
			click? <=> close?
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= List $mol_list
			rows <= member_rows /
		<= Drop_note $mol_paragraph
			title @ \"Remove" starts a new chat compartment without the person. Past messages stay with them: the key to them is already given and cannot be taken back. They will not see new ones.
		<= Add_block $mol_view
			sub <= add_rows /
		<= Leave_note $mol_paragraph
			title @ \"Leave" removes the group from your list. It stays for the others, and so do your past messages in it.
		<= Leave $mol_button_minor
			hint @ \Remove group from your list
			attr *
				^
				bog_gram_armed <= leave_armed? false
			click? <=> leave_click? null
			sub /
				<= leave_label \
	Add_title $mol_paragraph
		title @ \Add member
	History $mol_view
		sub /
			<= History_head $mol_paragraph
				title @ \What the new member will see
			<= History_row $mol_view
				sub /
					<= History_all $mol_button_minor
						hint @ \Give keys to all past messages
						attr *
							^
							bog_gram_current <= history_open false
						click? <=> history_all? null
						sub /
							<= history_all_label @ \Whole chat
					<= History_new $mol_button_minor
						hint @ \Start a new chat compartment
						attr *
							^
							bog_gram_current <= history_shut false
						click? <=> history_new? null
						sub /
							<= history_new_label @ \Only new ones
			<= History_note $mol_paragraph
				title <= history_note \
	Error $mol_paragraph
		title <= error
	Id_form $mol_view
		sub /
			<= Id_field $mol_string
				hint @ \Member ID
				value? <=> id? \
				submit? <=> id_add? null
			<= Id_add $mol_button_major
				click? <=> id_add? null
				sub /
					<= id_add_label @ \Add
	Pick_list $mol_list
		rows <= pick_rows /
	Admin_note $mol_paragraph
		title @ \An admin gets full control of the land: they can both invite people and change other people's rights. These abilities cannot be split.
	Join $mol_view
		sub /
			<= Join_head $mol_paragraph
				title @ \Group invitation link
			<= Join_hint $mol_paragraph
				title @ \You will not join instantly with it: whoever follows it sends a request, and you have to accept it, since the key to the chat is given to a person by name
			<= Join_text $mol_paragraph
				title <= join_link
			<= Join_copy $mol_button_copy
				title @ \Copy
				text <= join_link
			<= Join_qr_box $mol_view
				sub /
					<= Join_qr $bog_qr
						uri <= join_link
						gradient_stops /
							\#2f9e5f
							\#8fd14f
	Asks_head $mol_paragraph
		title <= asks_head \
	Asks_list $mol_list
		rows <= ask_rows /
	Ask_row* $bog_gram_row
		enabled false
		avatar_id <= ask_lord*
		tint <= ask_tint* 0
		title <= ask_title* \
		note <= ask_status* \
		tools /
			<= Ask_accept* $mol_button_minor
				hint @ \Accept into group
				click? <=> accept*?
				sub /
					<= Ask_accept_icon* $mol_icon_check
			<= Ask_reject* $mol_button_minor
				hint @ \Decline request
				click? <=> reject*?
				sub /
					<= Ask_reject_icon* $mol_icon_close
	Member_row* $bog_gram_row
		avatar_id <= person* \
		tint <= tint* 0
		title <= member_title* \
		note <= status*
		tools /
			<= Rule* $mol_button_minor
				hint @ \Make admin
				click? <=> rule_click*? null
				sub /
					<= Rule_icon* $mol_icon_shield_crown
			<= Drop* $mol_button_minor
				hint <= drop_hint* \
				attr *
					^
					bog_gram_armed <= armed*? false
				click? <=> drop_click*? null
				sub /
					<= Drop_icon* $mol_icon_account_remove
	Pick_row* $bog_gram_row
		click? <=> add*?
		avatar_id <= person* \
		tint <= tint* 0
		title <= label*
		note <= contact_source*
		marks /
			<= Pick_mark* $mol_icon_account_plus
