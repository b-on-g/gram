#!/bin/sh
set -e

root=$( git rev-parse --show-toplevel )
file="$root/version/version.ts"
[ -f "$file" ] || exit 0

current=$( sed -n "s/.*'\([0-9]*\.[0-9]*\.[0-9]*\)'.*/\1/p" "$file" )
[ -n "$current" ] || exit 0

base=${current%.*}
patch=${current##*.}
next="$base.$(( patch + 1 ))"

sed -i.bak "s/'$current'/'$next'/" "$file"
rm -f "$file.bak"

git add "$file"
